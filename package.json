{
  "name": "agmux",
  "version": "1.0.0",
  "private": true,
  "description": "Local web UI for managing agent terminal sessions with live streaming, triggers, and readiness detection",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjprins/agmux.git"
  },
  "homepage": "https://github.com/rjprins/agmux",
  "bugs": {
    "url": "https://github.com/rjprins/agmux/issues"
  },
  "author": "Rutger Prins",
  "scripts": {
    "app": "node scripts/build-ui.mjs && node --import tsx src/server.ts",
    "app:watch": "node scripts/build-ui.mjs && node --watch --import tsx src/server.ts",
    "dev": "node scripts/dev.mjs",
    "mcp": "node --import tsx src/mcp/server.ts",
    "mcp:install": "node scripts/install-mcp.mjs all",
    "mcp:install:codex": "node scripts/install-mcp.mjs codex",
    "mcp:install:claude": "node scripts/install-mcp.mjs claude",
    "ui:build": "node scripts/build-ui.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "start": "node dist/server.js",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "PWDEBUG=1 playwright test --headed",
    "test": "vitest run"
  },
  "keywords": [
    "terminal",
    "pty",
    "agent",
    "tmux",
    "websocket",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "ansi_up": "^6.0.6",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^5.0.0",
    "fastify": "^5.7.4",
    "node-pty": "^1.1.0",
    "preact": "^10.28.3",
    "strip-ansi": "^7.1.2",
    "ws": "^8.19.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
